# Generated for you by `npm run setup`. Every value has a safe local default.

# Where the CLI and MCP server send requests (local API by default).
ADLAB_API_URL=http://localhost:8787
# The token the CLI/MCP uses. Must match one entry in ADLAB_API_TOKENS.
ADLAB_API_TOKEN=

# Named agent secrets: name:secret,name:secret. The name shows up in the audit log.
# Agent secrets can REQUEST spend; they can never APPROVE it.
ADLAB_API_TOKENS=

# Shared dashboard password (humans). Approvals require a dashboard session.
ADLAB_DASHBOARD_PASSWORD=
# Signs session cookies.
ADLAB_SESSION_SECRET=

# Database. Leave empty for embedded Postgres (PGlite) stored in .adlab/pglite.
# Set to a postgres:// URL to use a real Postgres (e.g. `docker compose up db`).
DATABASE_URL=

# Data directory for embedded DB, local storage and the fake ad platform state.
ADLAB_DATA_DIR=.adlab

# Ad platform: fake (simulator, default) | meta (read-only unless live writes are enabled).
ADLAB_PLATFORM=fake
# Required for ADLAB_PLATFORM=meta
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_PIXEL_ID=
# Live writes are blocked unless BOTH are set: ADLAB_ENV=prod and ADLAB_ALLOW_LIVE_WRITES=true.
ADLAB_ENV=local
ADLAB_ALLOW_LIVE_WRITES=false

# Hard account-level weekly cap in minor units (cents). Applies on top of each brief's cap.
ADLAB_WEEKLY_CAP_CENTS=50000

# Decision actions the rules engine may apply without a human. Comma list of: kill,hold
# (promote and scale ALWAYS need approval).
ADLAB_AUTO_APPLY=

# Renderer: auto (HyperFrames if ffmpeg is on PATH, else fake) | hyperframes | fake
ADLAB_RENDERER=auto

# Optional: POST alerts and the daily digest as JSON to this URL (Slack/Hermes/Telegram bridge, etc.).
ADLAB_WEBHOOK_URL=

# Ports
ADLAB_API_PORT=8787
ADLAB_WEB_PORT=5173
